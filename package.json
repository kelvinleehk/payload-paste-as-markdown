{
  "name": "payload-paste-as-markdown",
  "version": "1.0.0",
  "description": "Payload CMS Lexical editor feature for pasting Markdown via a toolbar button, slash command, or drawer.",
  "license": "MIT",
  "homepage": "https://github.com/kelvinleehk/payload-paste-as-markdown#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvinleehk/payload-paste-as-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/kelvinleehk/payload-paste-as-markdown/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "payload-cms",
    "lexical",
    "markdown",
    "richtext",
    "rich-text"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.20.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "import": "./dist/exports/client.js",
      "default": "./dist/exports/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "clean": "rimraf dist *.tsbuildinfo",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@payloadcms/ui": "^3.0.0",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/richtext-lexical": "^3.87.1",
    "@payloadcms/ui": "^3.87.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "payload": "^3.87.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0"
  }
}
